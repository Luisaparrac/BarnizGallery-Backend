# Copy this file to application-local.properties (ignored by git) and fill in the values.
# Run locally with: .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=local"
# The database must start as a restore of the v1 backup: Flyway records it as baseline 1 and applies V2.
spring.datasource.url=jdbc:postgresql://localhost:5432/museo_local
spring.datasource.username=<USERNAME>
spring.datasource.password=<PASSWORD>

# The auction scheduler updates auction statuses every 60 s. Keep it off while testing migrated data.
app.auction.scheduler-enabled=false
